# GitHub API Token Configuration
# Copy this file to .env and fill in your token.
# A token raises your rate limit from 60 → 5,000 requests/hour.
#
# How to get a token:
#   1. Go to https://github.com/settings/tokens
#   2. Click "Generate new token (classic)"
#   3. Select scopes: (none needed — public API access only)
#   4. Copy the generated token below

VITE_GITHUB_TOKEN=ghp_your_personal_access_token_here
